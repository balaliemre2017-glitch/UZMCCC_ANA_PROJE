
from flask import Flask, request, redirect
import pathlib, json, os
from werkzeug.utils import secure_filename
app=Flask(__name__)
BASE=pathlib.Path(__file__).parent.parent
AUTH=BASE/'yedekler'/'auth.json'
LOG=BASE/'yedekler'/'paylasim_log.json'
ENV=BASE/'API_ANAHTARLAR.env'
HAFIZA=BASE/'yedekler'/'hafiza.json'
HAFIZA2=BASE/'HAFIZA.json'
UPLOAD=BASE/'uploads'
DB=BASE/'app'/'uzmccc.db'
UPLOAD.mkdir(parents=True, exist_ok=True)

def load_env():
    d={}
    if ENV.exists():
        for l in ENV.read_text(encoding='utf-8', errors='ignore').splitlines():
            if '=' in l and not l.strip().startswith('#'):
                try:
                    k,v=l.split('=',1)
                    d[k.strip()]=v.strip()
                except: pass
    return d

def save_env(new_d):
    # KALICI: eskiyi silme, ustune ekle
    old=load_env()
    # bos gelenleri eskiyi silme
    for k,v in new_d.items():
        if v and v.strip():
            old[k]=v.strip()
    ENV.parent.mkdir(parents=True, exist_ok=True)
    ENV.write_text('\n'.join([f"{k}={v}" for k,v in old.items()])+'\n', encoding='utf-8')

def load_auth():
    # KALICI: yedekler/auth.json tek kaynak
    if AUTH.exists():
        try:
            return json.loads(AUTH.read_text(encoding='utf-8'))
        except:
            return {}
    return {}

def save_auth(new_data):
    # KALICI: ustune ekle, silme!
    old=load_auth()
    # deep merge for master
    if 'master' in new_data and 'master' in old:
        old['master']={**old['master'], **new_data['master']}
        del new_data['master']
    old.update(new_data)
    AUTH.parent.mkdir(parents=True, exist_ok=True)
    AUTH.write_text(json.dumps(old, indent=2, ensure_ascii=False), encoding='utf-8')

def load_hafiza():
    # Iki yerden dene - hangisi varsa
    for p in [HAFIZA, HAFIZA2, BASE/'yedekler'/'hafiza.json']:
        if p.exists():
            try:
                return json.loads(p.read_text(encoding='utf-8'))
            except: pass
    return {"faz":"FAZ 1 KURUCU TAMAMLANDI","gecmis":[],"youtube":"ON"}

def save_hafiza(ek_gecmis=None):
    h=load_hafiza()
    if ek_gecmis:
        if 'gecmis' not in h: h['gecmis']=[]
        h['gecmis'].append(ek_gecmis)
    HAFIZA.parent.mkdir(parents=True, exist_ok=True)
    HAFIZA.write_text(json.dumps(h, indent=2, ensure_ascii=False), encoding='utf-8')
    # Ayni zamanda kok HAFIZA.json'a da yaz - cift yedek
    HAFIZA2.write_text(json.dumps(h, indent=2, ensure_ascii=False), encoding='utf-8')

@app.route('/')
def idx():
    env=load_env()
    auth=load_auth()
    hafiza=load_hafiza()
    master=auth.get('master',{})
    email=master.get('email','') or hafiza.get('master','balaliemre2017@gmail.com')
    phone=master.get('phone','')
    
    # LOG
    log_text="Henuz yok"
    if LOG.exists():
        try:
            data=json.loads(LOG.read_text(encoding='utf-8'))
            log_text="\n".join([f"{x['tarih'][11:19]} {x['platform']} {x['durum'][:70]}" for x in data[-15:][::-1]])
        except: pass
    
    # Uploads
    vlist=""
    if UPLOAD.exists():
        for f in sorted(UPLOAD.iterdir(), key=lambda x: x.stat().st_mtime, reverse=True)[:6]:
            if f.is_file():

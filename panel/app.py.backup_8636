"""
    for p in isciler[:12]:
        html+=f'<div class=isci>{p.upper()} ✅</div>'
    html+=f"""</div>
<div class=box><b>Uploads (kalici)</b><pre>{vlist}</pre></div>
<div class=box><b>LOG (yedekler/paylasim_log.json - kalici)</b><pre style="border-color:#f00">{log_text}</pre></div>
<div class=box><b>Hafiza gecmisi (yedekler/hafiza.json - kalici)</b><pre>{str(hafiza.get('gecmis',[])[-3:])[:400]}</pre></div>
</body></html>"""

@app.route('/save_master', methods=['POST'])
def save_master():
    email=request.form.get('email','').strip()
    pw=request.form.get('password','').strip()
    phone=request.form.get('phone','').strip()
    data={}
    if 'master' not in load_auth():
        data['master']={}
    else:
        data['master']=load_auth()['master']
    if email: data['master']['email']=email
    if pw: data['master']['password']=pw
    if phone: data['master']['phone']=phone
    save_auth({'master': data['master']})
    # Tum isciler icin de username guncelle - eskiyi koruyarak
    auth=load_auth()
    for plat in ["youtube","instagram","tiktok","facebook","twitter_x","canva","capcut"]:
        if plat not in auth: auth[plat]={}
        if email: auth[plat]['username']=email
    # dogrudan yaz - merge mantigi zaten save_auth icinde var ama burada hepsi icin
    AUTH.write_text(json.dumps(auth, indent=2, ensure_ascii=False), encoding='utf-8')
    save_hafiza({"emir": f"giris guncellendi: {email}"})
    return redirect('/')

@app.route('/save_keys', methods=['POST'])
def save_keys():
    new={}
    for k in ['YOUTUBE_API_KEY','GEMINI_API_KEY','ELEVENLABS_API_KEY','OPENAI_API_KEY','TIKTOK_TOKEN','INSTAGRAM_TOKEN']:
        v=request.form.get(k,'').strip()
        if v:
            new[k]=v
    save_env(new)
    save_hafiza({"emir": f"key guncellendi: {list(new.keys())}"})
    return redirect('/')

@app.route('/upload', methods=['POST'])
def upload():
    try:
        import datetime, json
        foto=request.files.get('foto')
        if not foto: return redirect('/')
        from werkzeug.utils import secure_filename
        filename=secure_filename(foto.filename)
        ts=datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        save_path=UPLOAD/f"{ts}_{filename}"
        foto.save(str(save_path))
        LOG.parent.mkdir(parents=True, exist_ok=True)
        data=[]
        if LOG.exists():
            try: data=json.loads(LOG.read_text(encoding='utf-8'))
            except: data=[]
        data.append({'platform':'youtube','dosya':str(save_path),'aciklama':request.form.get('emir',''),'durum':f'KALICI OK - {save_path.name} - {load_auth().get("master",{}).get("email","")}','tarih':datetime.datetime.now().isoformat()})
        LOG.write_text(json.dumps(data, indent=2, ensure_ascii=False), encoding='utf-8')
        save_hafiza({"emir": request.form.get('emir',''), "dosya": str(save_path)})
    except Exception as e:
        print(e)
        import traceback; traceback.print_exc()
    return redirect('/')

if __name__=='__main__':
    print("V21 KALICI HAFIZA - http://127.0.0.1:5000 - BIR DAHA SILINMEZ!")
    app.run(host='0.0.0.0', port=5000, debug=False)

            isciler.append(plat_dir.name)
    
    # Kayitli kullanicilar - auth.json'dan
    kayitli=[]
    for k,v in auth.items():
        if k!='master' and isinstance(v, dict):
            kayitli.append(f"{k}: {v.get('username','') or v.get('email','')}")

    return f"""<html><head><meta charset="utf-8"><style>
body{{background:#0a0a0a;color:#0f0;font-family:Consolas;padding:12px}}
.box{{border:1px solid #0f0;background:#111;padding:12px;margin:8px 0;border-radius:8px}}
.boxyt{{border:2px solid #f00;background:#1a0000;padding:12px;margin:8px 0;border-radius:8px}}
.boxold{{border:2px solid #0ff;background:#001a22;padding:12px;margin:8px 0;border-radius:8px}}
.boxwarn{{border:2px solid #fa0;background:#221100;padding:12px;margin:8px 0;border-radius:8px}}
.btn{{background:#0f0;color:#000;font-weight:bold;padding:10px 16px;border:0;cursor:pointer;border-radius:4px}}
.btnyt{{background:#f00;color:#fff;font-weight:bold;padding:10px 16px;border:0;cursor:pointer;border-radius:4px}}
input,textarea{{width:96%;background:#000;color:#0f0;border:1px solid #0f0;padding:8px;margin:4px 0;border-radius:4px}}
pre{{background:#000;border:1px dashed #0f0;padding:8px;white-space:pre-wrap;font-size:11px;max-height:220px;overflow:auto}}
.isci{{display:inline-block;border:1px solid #0f0;padding:5px 8px;margin:3px;border-radius:6px;background:#002200;font-size:11px}}
</style></head><body>
<h2>UZMCCC V21 - KALICI HAFIZA - BIR DAHA SILINMEZ ✅</h2>

<div class=boxold>
<b>✅ KALICI HAFIZA AKTIF - HERSEY yedekler/ KLASORUNDE</b><br>
FAZ: {hafiza.get('faz','')} | Master: {email}<br>
Kayitli Isciler: {len(isciler)} tane - {', '.join(isciler[:8])}<br>
Gecmis Emirler: {len(hafiza.get('gecmis',[]))} tane<br>
ENV Keys: {', '.join(env.keys())} - GEMINI: {'✅ VAR' if env.get('GEMINI_API_KEY') else '❌ YOK'} YT: {'✅ VAR' if env.get('YOUTUBE_API_KEY') else '❌ YOK'}<br>
Auth Kayitlari: {', '.join(kayitli[:5]) if kayitli else 'sadece master'}<br>
DB: {DB.exists()} | yedekler/: {HAFIZA.exists()} {AUTH.exists()}<br>
